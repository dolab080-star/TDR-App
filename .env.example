# Copy the values below into your Vercel project's Environment Variables
# (Project → Settings → Environment Variables), not into a committed .env
# file. See README.md "Selling the app" for how to get them.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...

# Email sign-in for returning buyers ("Already bought? Sign in").
# SIGNIN_SECRET: any long random string, e.g. the output of `openssl rand -hex 32`.
# RESEND_API_KEY / MAIL_FROM: from https://resend.com after verifying your sending domain.
# APP_URL: optional; the public site URL used in emails (defaults to the Vercel production URL).
SIGNIN_SECRET=change-me-to-a-long-random-string
RESEND_API_KEY=re_...
MAIL_FROM=Tesla Dance Revolution <signin@yourdomain.com>
APP_URL=https://yourdomain.com
